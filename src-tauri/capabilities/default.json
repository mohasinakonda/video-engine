{
  "$schema": "https://schema.tauri.app/config/2.json",
  "identifier": "default",
  "description": "Default capabilities for AI Video Studio",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "store:default",
    "fs:default",
    "fs:allow-mkdir",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-exists",
    "fs:allow-remove",
    {
      "identifier": "fs:allow-app-read-recursive",
      "allow": [
        { "path": "$APPLOCALDATA/**" }
      ]
    },
    {
      "identifier": "fs:allow-app-write-recursive",
      "allow": [
        { "path": "$APPLOCALDATA/**" }
      ]
    },
    "dialog:default",
    "notification:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "binaries/ffmpeg",
          "sidecar": true,
          "args": true
        }
      ]
    },
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/ffmpeg",
          "sidecar": true,
          "args": true
        }
      ]
    }
  ]
}